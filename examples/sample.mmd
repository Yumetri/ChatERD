erDiagram
direction LR
subgraph accounts [계정]
    USER["사용자"] {
        uuid id PK "사용자 식별자"
        int tenant_id UK "복합 유일 제약의 첫 컬럼"
        varchar(255) email UK "복합 유일 제약의 두 번째 컬럼"
        varchar(80) name "표시 이름"
        timestamp created_at "가입 시각"
    }
    PROFILE["프로필"] {
        uuid user_id PK, FK "사용자 키와 동일"
        text? bio "선택적인 자기소개"
    }
end
subgraph publishing [게시 및 댓글]
    POST["게시글"] {
        uuid id PK
        uuid user_id FK "작성자"
        varchar(200) title "게시글 제목"
        text? content "선택적인 본문"
        varchar(20) status "초안 또는 게시됨"
        timestamp created_at
    }
    COMMENT["댓글"] {
        uuid id PK
        uuid post_id FK
        uuid? author_id FK "탈퇴 후 작성자 없음 허용"
        uuid? parent_id FK "최상위 댓글에는 부모 없음"
        text body "댓글 내용"
        timestamp reviewed_at "NULL 정책 미정 예시"
    }
end
subgraph tagging [태그]
    TAG["태그"] {
        int id PK
        varchar(40) name UK
    }
    POST_TAG["게시글 태그"] {
        uuid post_id PK, FK
        int tag_id PK, FK
        timestamp created_at
    }
end
USER ||--o| PROFILE : "프로필"
USER ||..o{ POST : "작성"
POST ||..o{ COMMENT : "댓글"
USER |o..o{ COMMENT : "댓글 작성"
COMMENT |o..o{ COMMENT : "답글"
POST ||--o{ POST_TAG : "태그 연결"
TAG ||--o{ POST_TAG : "태그 참조"
