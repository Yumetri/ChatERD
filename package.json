{
  "name": "chaterd",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node runtime/cli.mjs setup",
    "build": "node runtime/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:render": "node tests/render-check.mjs",
    "test:drag": "node tests/drag-benchmark.mjs",
    "audit:licenses": "node scripts/license-audit.mjs",
    "licenses:update": "node scripts/license-audit.mjs --write"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.12.4",
    "codemirror": "6.0.2",
    "elkjs": "0.11.0",
    "js-yaml": "5.4.2",
    "mermaid": "12.0.0",
    "pngjs": "7.0.0",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.5"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "overrides": {
    "lodash-es": "4.18.1"
  },
  "license": "MIT",
  "description": "A local Mermaid ERD editor with live preview, editable layouts, and optional AI workflows.",
  "author": "Yumetri",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yumetri/ChatERD.git"
  },
  "homepage": "https://github.com/Yumetri/ChatERD#readme",
  "bugs": {
    "url": "https://github.com/Yumetri/ChatERD/issues"
  }
}
